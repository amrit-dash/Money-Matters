rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/raw_ingests/{ingestId} {
      allow read: if isOwner(uid);
      // Client may only mark cloud-mirrored ingests processed after local parse.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['processedAt']);
      allow create, delete: if false;
    }

    match /users/{uid}/parse_jobs/{jobId} {
      allow read: if isOwner(uid);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'rulesVersion', 'error', 'updatedAt'])
        && request.resource.data.status in ['done', 'failed'];
      allow create, delete: if false;
    }

    match /users/{uid}/transactions/{txId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/categories/{catId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/payment_sources/{sourceId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/device_tokens/{deviceId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/fcm_tokens/{tokenId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/llm_logs/{logId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /users/{uid}/settings/{docId} {
      allow read, write: if isOwner(uid);
    }
  }
}
