# Money Matters — local reference (optional)
# Copy to .env for your notes. The Flutter app does NOT load this file at runtime.
# Use app onboarding + Shortcuts for INGEST_URL and Bearer token.

# Deployed Cloud Function URL (region asia-south1)
INGEST_URL=https://asia-south1-money-matters-amrit.cloudfunctions.net/ingestSms

# Firebase project (must match firebase/.firebaserc and flutterfire configure)
FIREBASE_PROJECT_ID=money-matters-amrit

# iOS bundle ID (must match Xcode + Firebase iOS app registration)
IOS_BUNDLE_ID=com.moneymatters.moneyMatters

# Filled by app onboarding — paste into Shortcuts Authorization header
# DEVICE_ID=
# INGEST_BEARER_TOKEN=
