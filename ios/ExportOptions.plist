<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Export options for `flutter build ipa --export-options-plist=ios/ExportOptions.plist`

  Before use:
  1. Replace YOUR_TEAM_ID with your 10-character Apple Team ID
     (Xcode → Runner → Signing & Capabilities, or developer.apple.com/account)
  2. Choose export method:
     - development: install on devices registered to your team (fastest for personal dev)
     - ad-hoc: install on specific UDIDs listed in your provisioning profile
     - app-store: TestFlight / App Store (not used for sideload MVP)

  Used by: scripts/build_ipa.sh
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>development</string>
	<key>teamID</key>
	<string>F4TFHKUQDA</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>compileBitcode</key>
	<false/>
	<key>uploadBitcode</key>
	<false/>
	<key>uploadSymbols</key>
	<true/>
	<key>destination</key>
	<string>export</string>
	<key>thinning</key>
	<string>&lt;none&gt;</string>
</dict>
</plist>
